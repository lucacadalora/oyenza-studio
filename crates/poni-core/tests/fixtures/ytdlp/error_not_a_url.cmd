yt-dlp --ignore-config --no-plugin-dirs --color never --newline --encoding utf-8 --no-simulate --no-quiet --progress --progress-template 'download:{"t":"dl","id":"%(info.id)s","st":"%(progress.status)s","done":%(progress.downloaded_bytes|0)s,"total":%(progress.total_bytes|0)s,"est":%(progress.total_bytes_estimate|0)s,"speed":%(progress.speed|0)s,"eta":%(progress.eta|0)s,"frag":%(progress.fragment_index|0)s,"frags":%(progress.fragment_count|0)s}' --progress-template 'postprocess:{"t":"pp","id":"%(info.id)s","pp":"%(progress.postprocessor)s","st":"%(progress.status)s"}' --print 'before_dl:{"t":"info","id":%(id|null)j,"title":%(title|null)j,"site":%(extractor_key|null)j,"thumb":%(thumbnail|null)j,"duration":%(duration|null)j,"uploader":%(uploader|null)j}' --print 'after_move:{"t":"done","path":%(filepath|null)j}' --ffmpeg-location '<ffmpeg>' -o '<dir>/%(title).180B [%(id)s].%(ext)s' -- --version
